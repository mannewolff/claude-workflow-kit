  "ohnePruefung": [
    {
      "muster": "future/**",
      "grund": "Dort sind Anforderungsdokumente roh enthalten"
    },
    {
      "muster": "CHANGELOG.md",
      "grund": "Release-Protokoll; keine Pruefung liest seinen Inhalt — die Changelog-Tests legen sich ihr eigenes Protokoll in einem Wegwerfprojekt an."
    },
    {
      "muster": "LICENSE",
      "grund": "Lizenztext; keine Pruefung liest ihn."
    },
    {
      "muster": ".gitattributes",
      "grund": "Git-Attribute fuer die Ablage; keine Pruefung liest sie."
    },
    {
      "muster": ".claude/launch.json",
      "grund": "Startvorgaben der Oberflaeche; keine Pruefung liest sie."
    },
    {
      "muster": "sonar-project.properties",
      "grund": "Konfiguration des externen Analysedienstes; keine Pruefung dieses Repositories liest sie."
    },
    {
      "muster": "assets/fonts/OFL-*.txt",
      "grund": "Lizenztexte der Schriften; gemessen werden die woff2-Dateien, nicht ihre Lizenz."
    },
    {
      "muster": "assets/fonts/README.md",
      "grund": "Herkunftsnotiz zu den Schriftdateien; keine Pruefung liest sie."
    },
    {
      "muster": "konzepte/**",
      "grund": "Notizdokumente; keine Prüfung liest ihren Inhalt."
    }
  ],
  "nurGeruest": [
    {
      "muster": "package.json",
      "grund": "Genannt wird der Pfad nur in Kommentaren ueber Wegwerf-Projekte ('kein package.json'): test/ablauf-install-settings-hooks.test.mjs, test/ablauf-install-preise-blob.test.mjs, test/workflow-ci-trigger.test.mjs. Keine Testdatei liest die package.json dieses Repositories — gesucht wurde nach jedem Lesen ueber repoRoot (grep 'package' in test/)."
    },
    {
      "muster": "CLAUDE.md",
      "grund": "Einzige Fundstelle ist ein Kommentar in test/docs-nachtkette.test.mjs ueber das, was ein Nachtlauf nicht schreiben darf. Keine Testdatei liest die CLAUDE.md dieses Repositories; templates/CLAUDE-workflow.md dagegen wird von vielen Tests geprueft und traegt darum ein eigenes Muster nicht."
    }
  ],
