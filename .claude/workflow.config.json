{
  "codeHost": "github",
  "issueTracker": "toolbox",
  "buildChecks": [
    "node --test",
    "node tools/sync-blobs.mjs --check",
    "npx eslint kit tools test install.mjs .githooks"
  ],
  "mutationCommand": "",
  "mainBranch": "main",
  "productionBranch": "production",
  "reviewScope": "diff",
  "triggers": {
    "go": "GO",
    "push": "push main",
    "merge": "merge production"
  },
  "local": {
    "issuesDir": "issues"
  },
  "columns": {
    "backlog": "Backlog",
    "ready": "Ready",
    "in_progress": "In progress",
    "in_review": "In review",
    "done": "Done"
  },
  "reviewCommand": "codex exec --model gpt-6-astra -c model_reasoning_effort=\"high\"",
  "night": {
    "kette": {
      "label": "kit:night",
      "planMin": 30,
      "paketeMin": 25,
      "reviewMin": 30,
      "abdeckungMin": 10,
      "kostenUsd": 50,
      "korrekturrunden": 2
    },
    "modelle": [
      "claude-opus-5",
      "claude-sonnet-5"
    ]
  },
  "issueReview": {
    "requiredBeforeReady": false,
    "reviewers": [
      {
        "name": "opus",
        "kind": "claude",
        "model": "claude-opus-5"
      },
      {
        "name": "qwen",
        "kind": "command",
        "model": "qwen-kit",
        "command": "/Users/manfredwolff/.local/bin/claude-qwen -p --output-format text --system-prompt \"Bearbeite den Review-Auftrag aus stdin. Prüfe Aussagen am Bestand. Melde konkrete Befunde und ändere keine Dateien.\" --tools Read,Glob,Grep --allowedTools Read,Glob,Grep"
      },
      {
        "name": "sonnet",
        "kind": "claude",
        "model": "claude-sonnet-5"
      },
      {
        "name": "fable",
        "kind": "claude",
        "model": "claude-fable-5.1"
      },
      {
        "name": "gpt-astra",
        "kind": "command",
        "model": "gpt-6-astra",
        "command": "codex exec --model gpt-6-astra -c model_reasoning_effort=\"high\""
      },
      {
        "name": "gpt-sol",
        "kind": "command",
        "model": "gpt-5.6-sol",
        "command": "codex exec --model gpt-5.6-sol -c model_reasoning_effort=\"high\""
      }
    ],
    "pairs": {
      "opus": [
        "fable",
        "gpt-astra"
      ],
      "sonnet": [
        "gpt-astra",
        "qwen"
      ],
      "fable": [
        "opus",
        "gpt-astra"
      ],
      "gpt-sol": [
        "qwen",
        "gpt-astra"
      ],
      "qwen": [
        "opus",
        "gpt-astra"
      ],
      "gpt-astra": [
        "fable",
        "opus"
      ]
    }
  },
  "reviewStufen": {
    "fachlich": {
      "reviewer": 2,
      "rollen": [
        "form-beobachtbarkeit",
        "abgrenzung"
      ]
    },
    "plan": {
      "reviewer": 1,
      "rollen": [
        "architektur-bestand"
      ]
    },
    "issue": {
      "reviewer": 1,
      "rollen": [
        "pruefbarkeit"
      ]
    }
  },
  "toolbox": {
    "host": "https://kanban.mwolff.org",
    "ideaStored": false
  },
  "spec": {
    "seit": "2026-09-03",
    "bereiche": {
      "board": [
        "kit/board.mjs"
      ],
      "night": [
        "kit/night.mjs"
      ],
      "checks": [
        "kit/checks.mjs"
      ],
      "spec": [
        "kit/spec.mjs"
      ],
      "gate": [
        ".githooks/gate.mjs"
      ],
      "installer": [
        "install.mjs",
        "tools/sync-blobs.mjs"
      ],
      "skills": [
        "skills/**/SKILL.md"
      ],
      "einstellungen": [
        "kit/einstellungen.mjs"
      ]
    },
    "testGlobs": [
      "test/*.test.mjs"
    ],
    "testPattern": "\\[<ID>\\]"
  }
}
