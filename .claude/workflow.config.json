{
  "codeHost": "github",
  "issueTracker": "toolbox",
  "buildChecks": [
    {
      "cmd": "node --test \"test/night-*.test.mjs\" \"test/board-*.test.mjs\" \"test/migrate-*.test.mjs\" \"test/checks-*.test.mjs\" \"test/gate*.test.mjs\" \"test/aufwand-*.test.mjs\" \"test/wirksamkeit-*.test.mjs\" \"test/befunde-*.test.mjs\" \"test/guete-*.test.mjs\"",
      "areas": [
        "nachtrunner",
        "board",
        "pruefungen"
      ]
    },
    {
      "cmd": "node --test \"test/einstellungen-*.test.mjs\" \"test/config-*.test.mjs\" \"test/install-*.test.mjs\" \"test/sync-*.test.mjs\" \"test/tools-*.test.mjs\" \"test/changelog*.test.mjs\" \"test/derived-*.test.mjs\" \"test/copy-*.test.mjs\" \"test/kit-*.test.mjs\" \"test/cli-*.test.mjs\"",
      "areas": [
        "einstellungen",
        "installer"
      ]
    },
    {
      "cmd": "node --test \"test/skills-*.test.mjs\" \"test/docs-*.test.mjs\" \"test/workflow-*.test.mjs\" \"test/push-*.test.mjs\" \"test/mitteilung-*.test.mjs\" \"test/vergleiche-*.test.mjs\"",
      "areas": [
        "skills-doku"
      ]
    },
    "node tools/sync-blobs.mjs --check",
    "npx eslint kit tools test install.mjs .githooks"
  ],
  "mutationCommand": "",
  "mainBranch": "main",
  "productionBranch": "production",
  "reviewScope": "diff",
  "triggers": {
    "go": "GO",
    "push": "push main",
    "merge": "merge production"
  },
  "local": {
    "issuesDir": "issues"
  },
  "columns": {
    "backlog": "Backlog",
    "ready": "Ready",
    "in_progress": "In progress",
    "in_review": "In review",
    "done": "Done"
  },
  "checkAreas": {
    "nachtrunner": [
      "kit/night.mjs",
      "kit/board.mjs",
      "kit/checks.mjs",
      "kit/aufwand.mjs",
      "kit/wirksamkeit.mjs",
      "kit/befunde.mjs",
      "kit/preise.mjs",
      "test/night-*.test.mjs"
    ],
    "board": [
      "kit/board.mjs",
      "kit/board-ui.mjs",
      "kit/preise.mjs",
      "tools/migrate-issues.mjs",
      "test/board-*.test.mjs",
      "test/migrate-*.test.mjs"
    ],
    "pruefungen": [
      "kit/checks.mjs",
      "kit/aufwand.mjs",
      "kit/wirksamkeit.mjs",
      "kit/befunde.mjs",
      "kit/preise.mjs",
      ".githooks/**",
      "templates/**",
      "test/checks-*.test.mjs",
      "test/gate*.test.mjs",
      "test/aufwand-*.test.mjs",
      "test/wirksamkeit-*.test.mjs",
      "test/befunde-*.test.mjs",
      "test/guete-*.test.mjs"
    ],
    "einstellungen": [
      "kit/einstellungen.mjs",
      "templates/workflow.config.schema.json",
      "test/einstellungen-*.test.mjs",
      "test/config-*.test.mjs"
    ],
    "installer": [
      "install.mjs",
      "tools/**",
      ".githooks/**",
      "kit/**",
      "test/install-*.test.mjs",
      "test/sync-*.test.mjs",
      "test/tools-*.test.mjs",
      "test/changelog*.test.mjs",
      "test/derived-*.test.mjs",
      "test/copy-*.test.mjs",
      "test/kit-*.test.mjs",
      "test/cli-*.test.mjs"
    ],
    "skills-doku": [
      "skills/**",
      "docs/**",
      "templates/**",
      "RELEASING.md",
      "CLAUDE.md",
      "README.md",
      "kit/**",
      "test/skills-*.test.mjs",
      "test/docs-*.test.mjs",
      "test/workflow-*.test.mjs",
      "test/push-*.test.mjs",
      "test/mitteilung-*.test.mjs",
      "test/vergleiche-*.test.mjs"
    ]
  },
  "reviewCommand": "codex exec --model gpt-6-astra -c model_reasoning_effort=\"high\"",
  "night": {
    "kette": {
      "label": "kit:night",
      "planMin": 30,
      "paketeMin": 25,
      "reviewMin": 30,
      "abdeckungMin": 10,
      "kostenUsd": 50,
      "korrekturrunden": 2
    },
    "modelle": [
      "claude-fable-5",
      "claude-opus-5",
      "claude-sonnet-5"
    ],
    "stufen": {
      "schwer": {
        "modell": "claude-opus-5"
      },
      "mittel": {
        "modell": "claude-opus-5",
        "effort": "medium"
      },
      "leicht": {
        "modell": "claude-opus-5",
        "effort": "low"
      }
    }
  },
  "issueReview": {
    "requiredBeforeReady": false,
    "reviewers": [
      {
        "name": "opus",
        "kind": "claude",
        "model": "claude-opus-5"
      },
      {
        "name": "sonnet",
        "kind": "claude",
        "model": "claude-sonnet-5"
      },
      {
        "name": "fable",
        "kind": "claude",
        "model": "claude-fable-5.1"
      },
      {
        "name": "gpt-astra",
        "kind": "command",
        "model": "gpt-6-astra",
        "command": "codex exec --model gpt-6-astra -c model_reasoning_effort=\"high\""
      },
      {
        "name": "gpt-sol",
        "kind": "command",
        "model": "gpt-5.6-sol",
        "command": "codex exec --model gpt-5.6-sol -c model_reasoning_effort=\"high\""
      }
    ],
    "pairs": {
      "opus": [
        "fable",
        "gpt-astra"
      ],
      "sonnet": [
        "gpt-astra",
        "opus"
      ],
      "fable": [
        "opus",
        "gpt-astra"
      ],
      "gpt-sol": [
        "opus",
        "gpt-astra"
      ],
      "gpt-astra": [
        "fable",
        "opus"
      ]
    }
  },
  "reviewStufen": {
    "fachlich": {
      "reviewer": 2,
      "rollen": [
        "form-beobachtbarkeit",
        "abgrenzung"
      ]
    },
    "plan": {
      "reviewer": 1,
      "rollen": [
        "architektur-bestand"
      ]
    },
    "issue": {
      "reviewer": 1,
      "rollen": [
        "pruefbarkeit"
      ]
    }
  },
  "toolbox": {
    "host": "https://kanban.mwolff.org",
    "ideaStored": false
  }
}
