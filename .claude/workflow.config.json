{
  "codeHost": "github",
  "issueTracker": "toolbox",
  "buildChecks": [
    {
      "cmd": "node --test \"test/night-*.test.mjs\" \"test/board-*.test.mjs\" \"test/migrate-*.test.mjs\" \"test/checks-*.test.mjs\" \"test/gate*.test.mjs\" \"test/aufwand-*.test.mjs\" \"test/wirksamkeit-*.test.mjs\" \"test/befunde-*.test.mjs\" \"test/guete-*.test.mjs\"",
      "areas": [
        "board",
        "installer",
        "nachtrunner",
        "preise",
        "pruefungen"
      ]
    },
    {
      "cmd": "node --test \"test/einstellungen-*.test.mjs\" \"test/config-*.test.mjs\"",
      "areas": [
        "board",
        "einstellungen",
        "installer",
        "nachtrunner",
        "pruefungen"
      ]
    },
    {
      "cmd": "node --test \"test/cli-*.test.mjs\" \"test/sync-*.test.mjs\" \"test/kit-*.test.mjs\"",
      "areas": [
        "board",
        "installer",
        "pruefungen"
      ]
    },
    {
      "cmd": "node --test \"test/install-*.test.mjs\" \"test/tools-*.test.mjs\" \"test/changelog*.test.mjs\" \"test/derived-*.test.mjs\" \"test/copy-*.test.mjs\"",
      "areas": [
        "board",
        "einstellungen",
        "installer",
        "nachtrunner",
        "preise",
        "pruefungen",
        "worktree"
      ]
    },
    {
      "cmd": "node --test \"test/docs-*.test.mjs\"",
      "areas": [
        "einstellungen",
        "installer",
        "nachtrunner",
        "pruefungen",
        "skills-doku"
      ]
    },
    {
      "cmd": "node --test \"test/skills-*.test.mjs\" \"test/workflow-*.test.mjs\" \"test/push-*.test.mjs\" \"test/mitteilung-*.test.mjs\" \"test/vergleiche-*.test.mjs\"",
      "areas": [
        "board",
        "installer",
        "nachtrunner",
        "pruefungen",
        "skills-doku",
        "worktree"
      ]
    },
    "node tools/sync-blobs.mjs --check",
    "npx eslint kit tools test install.mjs .githooks"
  ],
  "mutationCommand": "",
  "mainBranch": "main",
  "productionBranch": "production",
  "reviewScope": "diff",
  "triggers": {
    "go": "GO",
    "push": "push main",
    "merge": "merge production"
  },
  "local": {
    "issuesDir": "issues"
  },
  "columns": {
    "backlog": "Backlog",
    "ready": "Ready",
    "in_progress": "In progress",
    "in_review": "In review",
    "done": "Done"
  },
  "checkAreas": {
    "nachtrunner": [
      "kit/night.mjs",
      "test/night-*.test.mjs",
      "test/helpers/ergebnisstand-fixture.mjs",
      "test/helpers/kette-fixture.mjs",
      "test/helpers/kette-umsetzung-fixture.mjs"
    ],
    "board": [
      "kit/board.mjs",
      "kit/board-ui.mjs",
      "tools/migrate-issues.mjs",
      "test/board-*.test.mjs",
      "test/migrate-*.test.mjs",
      "startboard.sh",
      "test/helpers/board-*.mjs"
    ],
    "pruefungen": [
      "kit/checks.mjs",
      "kit/aufwand.mjs",
      "kit/wirksamkeit.mjs",
      "kit/befunde.mjs",
      ".githooks/**",
      "templates/**",
      "test/checks-*.test.mjs",
      "test/gate*.test.mjs",
      "test/aufwand-*.test.mjs",
      "test/wirksamkeit-*.test.mjs",
      "test/befunde-*.test.mjs",
      "test/guete-*.test.mjs",
      "eslint.config.mjs",
      "test/helpers/aufwand-fixture.mjs",
      "test/helpers/checks-repo.mjs",
      "test/helpers/wirksamkeit-fixture.mjs"
    ],
    "einstellungen": [
      "kit/einstellungen.mjs",
      "templates/workflow.config.schema.json",
      "test/einstellungen-*.test.mjs",
      "test/config-*.test.mjs",
      "assets/fonts/*.woff2",
      "test/helpers/einstellungen-fixture.mjs",
      "test/helpers/mini-validator.mjs",
      "test/helpers/oberflaeche-vm.mjs"
    ],
    "worktree": [
      "kit/worktree.mjs"
    ],
    "installer": [
      "install.mjs",
      "tools/**",
      ".githooks/**",
      "test/install-*.test.mjs",
      "test/sync-*.test.mjs",
      "test/tools-*.test.mjs",
      "test/changelog*.test.mjs",
      "test/derived-*.test.mjs",
      "test/copy-*.test.mjs",
      "test/kit-*.test.mjs",
      "test/cli-*.test.mjs",
      ".gitignore",
      "package.json",
      "package-lock.json",
      "test/helpers/board-fixture.mjs"
    ],
    "skills-doku": [
      "skills/**",
      "docs/**",
      "templates/**",
      "RELEASING.md",
      "CLAUDE.md",
      "README.md",
      "test/skills-*.test.mjs",
      "test/docs-*.test.mjs",
      "test/workflow-*.test.mjs",
      "test/push-*.test.mjs",
      "test/mitteilung-*.test.mjs",
      "test/vergleiche-*.test.mjs",
      ".github/workflows/**",
      "docs-site/**",
      "package.json",
      "test/helpers/board-fixture.mjs"
    ],
    "konfiguration": [
      ".claude/workflow.config.json"
    ],
    "preise": [
      "kit/preise.mjs"
    ]
  },
  "ohnePruefung": [
    {
      "muster": "CHANGELOG.md",
      "grund": "Release-Protokoll; keine Pruefung liest seinen Inhalt — die Changelog-Tests legen sich ihr eigenes Protokoll in einem Wegwerfprojekt an."
    },
    {
      "muster": "LICENSE",
      "grund": "Lizenztext; keine Pruefung liest ihn."
    },
    {
      "muster": ".gitattributes",
      "grund": "Git-Attribute fuer die Ablage; keine Pruefung liest sie."
    },
    {
      "muster": ".claude/launch.json",
      "grund": "Startvorgaben der Oberflaeche; keine Pruefung liest sie."
    },
    {
      "muster": "sonar-project.properties",
      "grund": "Konfiguration des externen Analysedienstes; keine Pruefung dieses Repositories liest sie."
    },
    {
      "muster": "assets/fonts/OFL-*.txt",
      "grund": "Lizenztexte der Schriften; gemessen werden die woff2-Dateien, nicht ihre Lizenz."
    },
    {
      "muster": "assets/fonts/README.md",
      "grund": "Herkunftsnotiz zu den Schriftdateien; keine Pruefung liest sie."
    },
    {
      "muster": "konzept-rollen-als-agenten.md",
      "grund": "Notizdokument in der Wurzel; keine Pruefung liest seinen Inhalt."
    },
    {
      "muster": "prozess-pruefstand.md",
      "grund": "Notizdokument in der Wurzel; keine Pruefung liest seinen Inhalt."
    },
    {
      "muster": "prozess-pruefstand-nachtlauf.md",
      "grund": "Notizdokument in der Wurzel; keine Pruefung liest seinen Inhalt."
    }
  ],
  "reviewCommand": "codex exec --model gpt-6-astra -c model_reasoning_effort=\"high\"",
  "night": {
    "kette": {
      "label": "kit:night",
      "planMin": 30,
      "paketeMin": 25,
      "reviewMin": 30,
      "abdeckungMin": 10,
      "kostenUsd": 50,
      "korrekturrunden": 2
    },
    "modelle": [
      "claude-fable-5",
      "claude-opus-5",
      "claude-sonnet-5"
    ],
    "stufen": {
      "schwer": {
        "modell": "claude-opus-5"
      },
      "mittel": {
        "modell": "claude-opus-5",
        "effort": "medium"
      },
      "leicht": {
        "modell": "claude-opus-5",
        "effort": "low"
      }
    }
  },
  "issueReview": {
    "requiredBeforeReady": false,
    "reviewers": [
      {
        "name": "opus",
        "kind": "claude",
        "model": "claude-opus-5"
      },
      {
        "name": "sonnet",
        "kind": "claude",
        "model": "claude-sonnet-5"
      },
      {
        "name": "fable",
        "kind": "claude",
        "model": "claude-fable-5.1"
      },
      {
        "name": "gpt-astra",
        "kind": "command",
        "model": "gpt-6-astra",
        "command": "codex exec --model gpt-6-astra -c model_reasoning_effort=\"high\""
      },
      {
        "name": "gpt-sol",
        "kind": "command",
        "model": "gpt-5.6-sol",
        "command": "codex exec --model gpt-5.6-sol -c model_reasoning_effort=\"high\""
      }
    ],
    "pairs": {
      "opus": [
        "fable",
        "gpt-astra"
      ],
      "sonnet": [
        "gpt-astra",
        "opus"
      ],
      "fable": [
        "opus",
        "gpt-astra"
      ],
      "gpt-sol": [
        "opus",
        "gpt-astra"
      ],
      "gpt-astra": [
        "fable",
        "opus"
      ]
    }
  },
  "reviewStufen": {
    "fachlich": {
      "reviewer": 2,
      "rollen": [
        "form-beobachtbarkeit",
        "abgrenzung"
      ]
    },
    "plan": {
      "reviewer": 1,
      "rollen": [
        "architektur-bestand"
      ]
    },
    "issue": {
      "reviewer": 1,
      "rollen": [
        "pruefbarkeit"
      ]
    }
  },
  "toolbox": {
    "host": "https://kanban.mwolff.org",
    "ideaStored": false
  }
}
