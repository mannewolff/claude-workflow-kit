#!/bin/sh
# claude-workflow-kit pre-commit (Issue #470)
#
# Delegiert sofort an Node: Die Logik gehoert nach gate.mjs, weil sie testbar sein
# muss — ein Shell-Skript waere im Suite-Bestand ein Fremdkoerper. POSIX-sh, damit
# dieselbe Datei mit jeder sh laeuft, die git aufruft.
#
# Faellt node aus oder fehlt gate.mjs, endet der Hook mit Exit ungleich 0: Ein
# nicht lauffaehiges Gate laesst nicht durch.
#
# Fester Kit-Stand (Issue #1102, Plan #1101 A6): Arbeitet ein unbeaufsichtigter Lauf mit
# dem Kit des letzten Pushs, prueft auch dessen Gate. Bedingung sind alle drei:
# KIT_STAND_PFAD ist gesetzt, der Baum traegt die Markierung .claude/kit-stand.json, und
# das Gate des Stands liegt vor. Die Variable allein erbt jedes Fixture-Repo eines Tests.
#
# Meldungen in der Projektsprache (Issue #1458, Plan #1420 E13): je Meldung ein Wert
# de_<schluessel> und en_<schluessel>, Werte per printf %s. Die Sprache liest der Hook ohne
# node aus .claude/workflow.config.json — eine der Meldungen gilt gerade dem fehlenden node:
# "language", sonst "sprache", sonst de; ein unbekannter Wert gilt als de.
# SYNC: dieselbe Regel wie projektSprache in .githooks/gate.mjs und kit/board/namen.mjs.
de_gate_fehlt='pre-commit: %s fehlt — Commit abgewiesen.'
en_gate_fehlt='pre-commit: %s is missing — commit rejected.'
de_node_fehlt='pre-commit: node nicht im PATH — Commit abgewiesen.'
en_node_fehlt='pre-commit: node not in PATH — commit rejected.'

feldwert() {
  sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" .claude/workflow.config.json 2>/dev/null | head -n 1
}
sprache=de
if [ -f .claude/workflow.config.json ]; then
  wert="$(feldwert language)"
  [ -n "$wert" ] || wert="$(feldwert sprache)"
  [ "$wert" = en ] && sprache=en
fi

# melde <schluessel> [wert…]: die Meldung in der Projektsprache nach stderr.
melde() {
  eval "vorlage=\$${sprache}_$1"
  shift
  # shellcheck disable=SC2059 # die Vorlage ist das Format
  printf "$vorlage\n" "$@" >&2
}

gate="$(dirname "$0")/gate.mjs"
if [ -n "$KIT_STAND_PFAD" ] && [ -f "$KIT_STAND_PFAD/.githooks/gate.mjs" ]; then
  wurzel="$(git rev-parse --show-toplevel 2>/dev/null)"
  if [ -n "$wurzel" ] && [ -f "$wurzel/.claude/kit-stand.json" ]; then
    gate="$KIT_STAND_PFAD/.githooks/gate.mjs"
  fi
fi
if [ ! -f "$gate" ]; then
  melde gate_fehlt "$gate"
  exit 1
fi
if ! command -v node >/dev/null 2>&1; then
  melde node_fehlt
  exit 1
fi
exec node "$gate" pre-commit
