docs/node_modules
docs-site/node_modules
docs-site/.vitepress/dist
docs-site/.vitepress/cache
docs/public/install.mjs
docs/public/board-ui.mjs
# Coverage-Report fuer SonarCloud (Issue #185) — Generat, entsteht im Workflow
coverage/
# SonarQube-Scanner: lokales Arbeitsverzeichnis bei manuellen Laeufen
.scannerwork/
# macOS
.DS_Store
# JetBrains IDEs
.idea/
# claude-workflow-kit (Issue #208/#209): workflow.config.json gehoert ins Repo, alles
# andere unter .claude/ ist lokaler Zustand. Erste Zeile MUSS '.claude/*' lauten, nicht
# '.claude/': Git wertet ein !-Muster nicht aus, wenn das Verzeichnis ausgeschlossen ist —
# ein gesperrtes Verzeichnis macht jede Ausnahme darin wirkungslos, auch die fuer
# workflow.config.json.
# Die Regel dahinter: Was install.mjs schreibt, gehoert nicht ins Repo. Der Installer
# ueberschreibt es beim naechsten Lauf ohnehin, und jeder soll selbst entscheiden, ob er
# neu installiert — eine versionierte Kopie nimmt ihm die Entscheidung ab und driftet
# bis dahin. Das betrifft die CLAUDE*.md-Dateien, .claude/skills/ und .claude/kit/;
# Quelle sind templates/, skills/ und kit/.
# workflow.config.json ist die eine Ausnahme, und zwar begruendet: Der Installer
# ueberschreibt sie nicht, er MERGT sie ({...DEFAULTS, ...existingConfig, <abgefragt>}).
# Sie ist Team-Einstellung, kein Generat.
# launch.json legt der Installer gar nicht erst an.
.claude/*
!.claude/workflow.config.json
!.claude/launch.json
.claude/workflow.config.local.json
.claude/board-meta-cache.json

.agents/
.codex/
