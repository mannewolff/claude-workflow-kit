{
  "codeHost": "github",
  "issueTracker": "github",
  "buildChecks": [
    "mvn verify",
    {
      "cmd": "npm --prefix frontend run build",
      "areas": [
        "frontend"
      ]
    }
  ],
  "checkAreas": {
    "frontend": [
      "frontend/**"
    ]
  },
  "mutationCommand": "mvn org.pitest:pitest-maven:mutationCoverage",
  "formatFixCommand": "",
  "mainBranch": "main",
  "productionBranch": "production",
  "reviewScope": "diff",
  "reviewModel": "claude-opus-4-8",
  "triggers": {
    "go": "GO",
    "push": "push main",
    "merge": "merge production"
  },
  "local": {
    "issuesDir": "issues"
  },
  "columns": {
    "backlog": "Backlog",
    "ready": "Ready",
    "in_progress": "In progress",
    "in_review": "In review",
    "done": "Done"
  },
  "github": {
    "projectNumber": 1
  },
  "issueReview": {
    "rounds": 1,
    "requiredBeforeReady": false,
    "statusLabels": false,
    "reviewers": [
      {
        "name": "opus",
        "kind": "claude",
        "model": "claude-opus-5"
      },
      {
        "name": "sonnet",
        "kind": "claude",
        "model": "claude-sonnet-5"
      },
      {
        "name": "fable",
        "kind": "claude",
        "model": "claude-fable-5"
      }
    ],
    "pairs": {
      "opus": [
        "sonnet",
        "fable"
      ],
      "sonnet": [
        "opus",
        "fable"
      ],
      "fable": [
        "opus",
        "sonnet"
      ],
      "haiku": [
        "sonnet",
        "opus"
      ]
    }
  },
  "reviewStufen": {
    "fachlich": {
      "reviewer": 2,
      "rollen": [
        "form-beobachtbarkeit",
        "abgrenzung"
      ]
    },
    "plan": {
      "reviewer": 2,
      "rollen": [
        "architektur-bestand",
        "schnitt-abhaengigkeiten"
      ]
    },
    "issue": {
      "reviewer": 1,
      "rollen": [
        "pruefbarkeit"
      ]
    }
  }
}
